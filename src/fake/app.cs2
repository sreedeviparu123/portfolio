@import "tailwindcss";
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body{
  font-family:'Poppins',sans-serif;
  background:#f4f7fb;
  color:#111827;
}

/* MAIN */

.portfolio{
  width:100%;
  min-height:100vh;
  padding:0 8%;
}

/* NAVBAR */

.navbar{
  width:100%;
  height:90px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:1.5rem;
  font-weight:700;
  color:#111827;
  letter-spacing:2px;
}

.nav-links{
  display:flex;
  gap:35px;
}

.nav-links a{
  text-decoration:none;
  color:#475569;
  transition:0.3s;
  font-weight:500;
}

.nav-links a:hover{
  color:#2563eb;
}

/* HERO */

.hero{
  min-height:90vh;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:70px;
}

.hero-content{
  flex:1;
}

.intro{
  color:#2563eb;
  letter-spacing:4px;
  font-size:0.9rem;
  margin-bottom:20px;
  font-weight:600;
}

.hero h1{
  font-size:5rem;
  line-height:1.1;
  margin-bottom:25px;
  color:#0f172a;
}

.hero-text{
  max-width:600px;
  color:#475569;
  line-height:1.9;
  font-size:1.05rem;
}

/* BUTTONS */

.hero-buttons{
  display:flex;
  gap:20px;
  margin-top:40px;
}

.primary-btn{
  padding:15px 34px;
  border:none;
  border-radius:14px;
  background:#2563eb;
  color:white;
  font-weight:600;
  cursor:pointer;
  transition:0.3s;
}

.primary-btn:hover{
  transform:translateY(-4px);
  background:#1d4ed8;
}

.secondary-btn{
  padding:15px 34px;
  border-radius:14px;
  border:1px solid #cbd5e1;
  background:white;
  color:#111827;
  cursor:pointer;
  transition:0.3s;
}

.secondary-btn:hover{
  border-color:#2563eb;
  color:#2563eb;
}

/* RIGHT CARD */

.hero-card{
  width:340px;
  height:400px;
  background:white;
  border-radius:30px;
  padding:40px;
  box-shadow:0 20px 50px rgba(15,23,42,0.08);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  transition:0.3s;
}

.hero-card:hover{
  transform:translateY(-8px);
}

.card-circle{
  width:90px;
  height:90px;
  border-radius:50%;
  background:linear-gradient(135deg,#2563eb,#60a5fa);
  margin-bottom:25px;
}

.hero-card h2{
  font-size:1.8rem;
  margin-bottom:10px;
  color:#0f172a;
}

.hero-card span{
  color:#2563eb;
  font-weight:500;
}

.line{
  width:70px;
  height:4px;
  background:#2563eb;
  border-radius:10px;
  margin:25px 0;
}

.hero-card p{
  color:#64748b;
  line-height:1.8;
}

/* SECTION */

.section{
  padding:100px 0;
}

.section h2{
  font-size:2.5rem;
  margin-bottom:35px;
  color:#0f172a;
}

/* CARD */

.card{
  background:white;
  padding:40px;
  border-radius:24px;
  box-shadow:0 10px 30px rgba(15,23,42,0.06);
}

.card p{
  color:#475569;
  line-height:2;
}

/* SKILLS */

.skills{
  display:flex;
  flex-wrap:wrap;
  gap:20px;
}

.skill{
  padding:16px 28px;
  background:white;
  border-radius:14px;
  box-shadow:0 8px 20px rgba(15,23,42,0.05);
  transition:0.3s;
  font-weight:500;
}

.skill:hover{
  transform:translateY(-5px);
  background:#2563eb;
  color:white;
}

/* PROJECT */

.project-card{
  background:#0f172a;
  color:white;
  padding:50px;
  border-radius:30px;
}

.project-card h3{
  font-size:2rem;
  margin-bottom:20px;
}

.project-card p{
  color:#cbd5e1;
  max-width:600px;
  line-height:1.9;
}

/* RESPONSIVE */

@media(max-width:1000px){

  .hero{
    flex-direction:column;
    padding-top:50px;
  }

  .hero h1{
    font-size:4rem;
  }

}

@media(max-width:768px){

  .nav-links{
    display:none;
  }

  .hero h1{
    font-size:2.8rem;
  }

  .hero-buttons{
    flex-direction:column;
  }

  .hero-card{
    width:100%;
  }

  .section h2{
    font-size:2rem;
  }

}